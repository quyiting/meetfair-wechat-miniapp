.place-page { background: #f6f8fc; min-height: 100vh; }.place-map { height: 410rpx; width: 100%; }.place-shell { margin-top: -32rpx; padding-top: 0; position: relative; }.place-heading { background: #fff; border-radius: 28rpx 28rpx 0 0; display: flex; justify-content: space-between; padding: 34rpx 28rpx 22rpx; }.place-name { color: #1c2942; font-size: 39rpx; font-weight: 800; margin-top: 15rpx; }.place-meta { color: #748097; font-size: 23rpx; margin-top: 10rpx; }.fair-badge { align-items: center; background: #e9f8f2; border-radius: 15rpx; color: #198f6d; display: flex; flex-direction: column; font-size: 20rpx; font-weight: 700; height: 86rpx; justify-content: center; margin-top: 18rpx; width: 86rpx; }.fair-badge text:first-child { font-size: 24rpx; }.address { align-items: center; background: #fff; border-top: 1rpx solid #f0f2f6; color: #627089; display: flex; font-size: 23rpx; padding: 20rpx 28rpx; }.address-icon { color: #2f68ec; font-size: 30rpx; margin-right: 12rpx; }.place-note { background: #fff8eb; border-radius: 15rpx; color: #95651c; font-size: 23rpx; line-height: 1.5; margin-top: 20rpx; padding: 19rpx 22rpx; }.metrics { display: flex; justify-content: space-around; margin-top: 27rpx; padding: 26rpx 0; text-align: center; }.metric-value { color: #265dde; font-size: 42rpx; font-weight: 800; }.metric-unit { color: #5c6a82; font-size: 22rpx; }.metric-label { color: #8390a4; font-size: 21rpx; margin-top: 10rpx; }.metric-separator { background: #e9edf4; height: 63rpx; margin-top: 8rpx; width: 1rpx; }.travel-title { margin-top: 39rpx; }.travel-list { margin-top: 18rpx; padding: 5rpx 25rpx; }.travel-row { align-items: center; border-bottom: 1rpx solid #eef1f5; display: flex; justify-content: space-between; padding: 22rpx 0; }.travel-row:last-child { border: 0; }.travel-person { align-items: center; color: #2c3851; display: flex; font-size: 26rpx; font-weight: 700; }.tiny-avatar { align-items: center; background: #eaf1ff; border-radius: 50%; color: #3869de; display: flex; font-size: 20rpx; height: 45rpx; justify-content: center; margin-right: 13rpx; width: 45rpx; }.travel-time { align-items: flex-end; color: #265edf; display: flex; flex-direction: column; font-size: 25rpx; font-weight: 750; }.travel-time text:last-child { color: #8994a7; font-size: 20rpx; font-weight: 400; margin-top: 3rpx; }.bottom-actions { display: flex; gap: 16rpx; margin-top: 32rpx; }.nav-button, .vote-large { border-radius: 17rpx; font-size: 27rpx; font-weight: 750; height: 94rpx; line-height: 94rpx; }.nav-button { background: #1f5eff; color: #fff; flex: 1.35; }.vote-large { background: #edf2fb; color: #52627d; flex: 1; }.vote-large.voted { background: #fff0ee; color: #e85e4b; }
.budget-detail { color: #248b6d; font-size: 22rpx; margin: 17rpx 5rpx 0; }
