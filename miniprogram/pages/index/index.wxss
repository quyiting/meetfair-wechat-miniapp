.home-page { padding-top: 28rpx; }
.topbar { align-items: center; display: flex; justify-content: space-between; margin-bottom: 30rpx; }
.brand { align-items: center; color: #16213a; display: flex; font-size: 36rpx; font-weight: 800; letter-spacing: 1rpx; }
.brand-dot { background: #1f5eff; border-radius: 50%; box-shadow: 13rpx 0 0 #87aaff; height: 16rpx; margin-right: 16rpx; width: 16rpx; }
.brand-note { color: #7c879c; font-size: 23rpx; }
.hero { background: linear-gradient(145deg, #1f5eff, #5487ff); border: 0; color: #fff; min-height: 534rpx; overflow: hidden; padding: 48rpx 42rpx 38rpx; position: relative; }
.hero-orbit { border: 1rpx solid rgba(255,255,255,.22); border-radius: 50%; position: absolute; }
.orbit-one { height: 480rpx; right: -188rpx; top: -145rpx; width: 480rpx; }
.orbit-two { height: 305rpx; right: -70rpx; top: -60rpx; width: 305rpx; }
.hero-eyebrow { color: #cbd9ff; position: relative; }
.hero-title { font-size: 52rpx; font-weight: 800; letter-spacing: .5rpx; line-height: 1.23; margin-top: 20rpx; position: relative; }
.hero-copy { color: #e5ecff; font-size: 26rpx; line-height: 1.65; margin-top: 24rpx; position: relative; width: 510rpx; }
.hero-button { background: #fff; color: #205ce8; margin: 30rpx 0 0; position: relative; width: 100%; }.join-code-button { background: rgba(255,255,255,.18); border: 1rpx solid rgba(255,255,255,.35); border-radius: 16rpx; color: #fff; font-size: 24rpx; font-weight: 700; line-height: 78rpx; margin: 18rpx 0 0; padding: 0; position: relative; width: 100%; }
.steps { align-items: center; display: flex; justify-content: center; margin: 38rpx 4rpx; }
.step { align-items: center; color: #5d6880; display: flex; flex-direction: column; font-size: 20rpx; white-space: nowrap; }
.step-number { color: #2460f1; font-size: 24rpx; font-weight: 800; margin-bottom: 9rpx; }
.step-line { background: #d9e1f1; height: 2rpx; margin: -18rpx 12rpx 0; width: 50rpx; }
.room-arrow { color: #9ba7bc; font-size: 46rpx; font-weight: 300; }
.my-section { margin-top: 48rpx; }.room-list { margin-top: 20rpx; }.room-card { margin-bottom: 18rpx; padding: 26rpx; }.room-card-head, .member-row { align-items: center; display: flex; justify-content: space-between; }.room-title { font-size: 29rpx; font-weight: 750; }.room-meta { color: #8390a5; font-size: 22rpx; margin-top: 9rpx; }.member-row { border-top: 1rpx solid #eef1f6; color: #77839a; font-size: 22rpx; margin-top: 22rpx; padding-top: 18rpx; }.mini-avatars { display: flex; }.mini-avatar { border: 3rpx solid #fff; border-radius: 50%; color: #fff; font-size: 18rpx; height: 37rpx; line-height: 31rpx; margin-right: -8rpx; text-align: center; width: 37rpx; }
.privacy-note { color: #9ca6b7; font-size: 21rpx; margin-top: 62rpx; text-align: center; }
.form-label-row { align-items: center; display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.form-label-row .form-label { margin-bottom: 0; }
.form-paste { color: #2c65e6; font-size: 24rpx; font-weight: 700; padding: 6rpx 4rpx; }
.form-hint { color: #9aa5b6; font-size: 21rpx; line-height: 1.5; margin-top: 14rpx; }
.modal-mask { background: rgba(0,0,0,.55); bottom: 0; left: 0; position: fixed; right: 0; top: 0; z-index: 1000; }.modal-dialog { background: #fff; border-radius: 28rpx; margin: 200rpx 40rpx; overflow: hidden; }.modal-header { align-items: center; display: flex; justify-content: space-between; padding: 32rpx 32rpx 0; }.modal-title { font-size: 32rpx; font-weight: 800; color: #1e2a43; }.modal-close { color: #99a6bb; font-size: 44rpx; line-height: 1; padding: 0 10rpx; }.modal-body { padding: 32rpx; }.form-group { margin-bottom: 32rpx; }.form-label { color: #4a5568; font-size: 24rpx; font-weight: 700; margin-bottom: 16rpx; }.form-input { background: #f5f7fa; border-radius: 16rpx; box-sizing: border-box; font-size: 28rpx; padding: 24rpx; width: 100%; }.modal-footer { padding: 0 32rpx 32rpx; }.modal-submit { background: linear-gradient(135deg, #1f5eff, #2c75ff); border-radius: 16rpx; color: #fff; font-size: 28rpx; font-weight: 800; line-height: 88rpx; width: 100%; }
