.room-page { background: #f6f8fc; min-height: 100vh; }.room-hero { background: linear-gradient(145deg, #183b91, #235fe8); color: #fff; }.room-hero-inner { padding-bottom: 44rpx; padding-top: 34rpx; }.room-topline { align-items: flex-start; display: flex; justify-content: space-between; }.room-eyebrow { color: #bbcfff; }.room-name { font-size: 44rpx; font-weight: 800; margin-top: 13rpx; }.invite-button { background: rgba(255,255,255,.16); border: 1rpx solid rgba(255,255,255,.42); border-radius: 999rpx; color: #fff; font-size: 23rpx; line-height: 62rpx; margin: 8rpx 0 0; padding: 0 23rpx; }.room-code-wrap { align-items: center; background: rgba(255,255,255,.15); backdrop-filter: blur(8rpx); border: 1rpx solid rgba(255,255,255,.25); border-radius: 20rpx; display: flex; gap: 16rpx; padding: 14rpx 20rpx; transition: background .15s; }.room-code-wrap:active { background: rgba(255,255,255,.25); }.code-icon { align-items: center; background: rgba(255,255,255,.18); border-radius: 12rpx; color: #fff; display: flex; font-size: 28rpx; font-weight: 800; height: 56rpx; justify-content: center; width: 56rpx; }.code-center { flex: 1; min-width: 0; }.code-label { color: rgba(255,255,255,.7); font-size: 20rpx; font-weight: 600; }.code-preview { color: #fff; font-size: 22rpx; font-weight: 700; margin-top: 2rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.code-copy-btn { background: rgba(255,255,255,.22); border-radius: 10rpx; color: #fff; font-size: 21rpx; font-weight: 700; line-height: 48rpx; padding: 0 20rpx; }.room-time { color: #d7e2ff; font-size: 24rpx; margin-top: 14rpx; }.avatar-strip { align-items: center; color: #dbe6ff; display: flex; font-size: 22rpx; margin-top: 31rpx; }.member-avatar, .add-avatar { border: 3rpx solid #2655b4; border-radius: 50%; color: #fff; font-size: 21rpx; height: 53rpx; line-height: 47rpx; margin-right: -10rpx; text-align: center; width: 53rpx; }.add-avatar { background: rgba(255,255,255,.13); margin-left: 5rpx; }.avatar-strip text { margin-left: 25rpx; }
